DB_URL=jdbc:mysql://localhost:3306/mowoo
DB_USERNAME=
DB_PASSWORD=
# 32바이트 이상의 임의 문자열
JWT_SECRET=

# 각 제공자 콘솔에서 발급받은 클라이언트 ID·시크릿 (로그인 후 받는 액세스 토큰이 아님)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/login/oauth2/code/kakao
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/login/oauth2/code/google
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:3000/login/oauth2/code/naver
AUTH_COOKIE_SECURE=true

# 웹 프론트에서 호출할 때 허용할 출처 목록을 쉼표로 구분
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# S3를 사용하는 환경에서만 설정
# AWS_S3_ENABLED=true
# AWS_REGION=ap-northeast-2
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_LOCATION=uploads

# Upstage: actual key belongs only in the ignored local .env.
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-pro4
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_ENABLED=false
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000
MOWOO_EMOTION_SEED_ENABLED=false
